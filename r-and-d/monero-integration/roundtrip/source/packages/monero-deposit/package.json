{
  "name": "@rosen-bridge/monero-deposit",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned Monero deposit intent codec and stateless candidate policy",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist tsconfig.build.tsbuildinfo",
    "coverage": "npm run test -- --run --coverage",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "test": "node --import tsx ../../node_modules/vitest/vitest.mjs",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
